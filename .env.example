# Variable NAMES the app reads. Copy to .env.local and fill in — never commit .env.local.
# Supabase project URL (https://<project-ref>.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=
# Public anon / publishable key — set ONE of these two (never the service_role key).
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_DEFAULT_KEY=
